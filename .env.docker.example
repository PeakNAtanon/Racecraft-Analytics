# Public web/runtime
F1_SEASON=2026
NEXT_PUBLIC_SITE_URL=https://f1.example.com
NEXT_PUBLIC_ADSENSE_CLIENT=
CONTACT_EMAIL=peaknatanon@gmail.com
ENABLE_DEV_DIAGNOSTICS=false

# Provider adapters — no API keys are required by the current adapters
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
RSS_FEEDS=https://www.autosport.com/rss/f1/news/,https://www.motorsport.com/rss/f1/news/
PROVIDER_USER_AGENT=RacecraftAnalytics/0.1

# Self-hosted PostgreSQL. Keep this password URL-safe or URL-encode it in DATABASE_URL.
POSTGRES_DB=racecraft
POSTGRES_USER=racecraft
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://racecraft:replace-with-a-long-url-safe-password@postgres:5432/racecraft
REDIS_URL=redis://redis:6379

# FastF1 cache inside the worker container
FASTF1_CACHE=/data/fastf1-cache
TELEMETRY_STORAGE_PATH=/data/telemetry
FASTF1_ENABLED=true
